# infra.env.multi — consumer contract for vendor/fed-infra (multi profile)
#
# Mirrors infra.env (the single-profile contract): every value below is
# identical to infra.env except FED_CLUSTER_NAME (distinct host cluster
# name, so `kind get clusters` never collides with the single profile's),
# FED_PROFILE, FED_MEMBER_COUNT/FED_MEMBER_PREFIX (new: how many Karmada
# member clusters to create and their name prefix), FED_COMPONENTS (adds
# `karmada`), and FED_KARMADA_CONFIG (where fed-infra writes the Karmada
# apiserver kubeconfig -- setup/install_multi.sh reads this same var to
# build the Secret k8s/temporal-worker.yaml mounts).
#
# FED_NAMESPACE stays "active-fed": shared services and worker Jobs run in
# this namespace on every cluster (host and members alike), same as single.
FED_CLUSTER_NAME=active-fed-host
FED_NAMESPACE=active-fed
FED_PROFILE=multi
FED_COMPONENTS=kfp,training,temporal,minio,mlflow,karmada,k8s-dashboard,karmada-dashboard
FED_KFP_VERSION=2.4.0
FED_TRAINING_OPERATOR_VERSION=v1.7.0
FED_KIND_WORKERS=1

FED_MEMBER_COUNT=2
FED_MEMBER_PREFIX=active-fed-member
FED_KARMADA_CONFIG=${HOME}/.karmada/karmada-apiserver.config

FED_TEMPORAL_VERSION=0.62.0
FED_NODEPORT_TEMPORAL_UI=30733
FED_HOSTPORT_TEMPORAL_UI=8233

FED_S3_ENDPOINT=minio-service.active-fed.svc.cluster.local:9000
FED_S3_ACCESS_KEY=minioadmin
FED_S3_SECRET_KEY=minioadmin
FED_S3_BUCKET=mlflow-artifacts

FED_IMAGES="active-fed-worker:v1 active-fed-aggregator:v1"

FED_NODEPORT_KFP=30080
FED_NODEPORT_MLFLOW=30500
FED_NODEPORT_MINIO_API=30900
FED_NODEPORT_MINIO_CONSOLE=30901
FED_HOSTPORT_KFP=8080
FED_HOSTPORT_MLFLOW=5050
FED_HOSTPORT_MINIO_API=9000
FED_HOSTPORT_MINIO_CONSOLE=9001
